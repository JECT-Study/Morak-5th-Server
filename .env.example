# PostgreSQL connection
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.poizkwdqnxtxeiwpwbzx
DB_PASSWORD=

# Kakao Developers > App > Platform Key > REST API key
KAKAO_REST_API_KEY=
# Optional; fill only if Client Secret is enabled in Kakao Developers
KAKAO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in Kakao Developers
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/callback/kakao

# Local secret for signing Morak access tokens; do not commit your real value
JWT_SECRET=

# Origins allowed to open the chat WebSocket (/ws), comma-separated
WS_ALLOWED_ORIGINS=http://localhost:3000

# Optional challenge cover uploads. Point to a private bucket and use a server-only key.
CHALLENGE_COVER_STORAGE_ENABLED=false
SUPABASE_PROJECT_URL=
SUPABASE_STORAGE_API_KEY=
SUPABASE_CHALLENGE_COVER_BUCKET=

# Optional Expo push delivery. Leave disabled locally so no real push is sent.
PUSH_EXPO_ENABLED=false
# Only needed if Expo enhanced push security is enabled; do not commit your real value
EXPO_ACCESS_TOKEN=
